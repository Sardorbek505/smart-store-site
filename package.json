{
  "name": "smart-store-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:styles": "node tools/build-styles.mjs",
    "check:styles": "node tools/build-styles.mjs --check",
    "build": "npm run build:styles && npm run build:checkout && npm run build:csp",
    "build:csp": "node tools/sync-csp.mjs",
    "check:csp": "node tools/sync-csp.mjs --check",
    "check:site": "python3 tools/check-site.py",
    "build:checkout": "node tools/build-checkout.mjs",
    "check:checkout": "node tools/build-checkout.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.180.0"
  }
}
